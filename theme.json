{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultDuotones": true,
			"defaultGradients": true,
			"defaultPalette": true,
			"palette": [
				{
					"slug": "black",
					"color": "#000000",
					"name": "Black"
				},
				{
					"slug": "white",
					"color": "#ffffff",
					"name": "White"
				},
				{
					"slug": "primary",
					"color": "#000000",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#ffffff",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#007cba",
					"name": "Accent"
				},
				{
					"slug": "neutral-50",
					"color": "#fafafa",
					"name": "Neutral 50"
				},
				{
					"slug": "neutral-100",
					"color": "#f5f5f5",
					"name": "Neutral 100"
				},
				{
					"slug": "neutral-200",
					"color": "#e5e5e5",
					"name": "Neutral 200"
				},
				{
					"slug": "neutral-300",
					"color": "#d4d4d4",
					"name": "Neutral 300"
				},
				{
					"slug": "neutral-400",
					"color": "#a3a3a3",
					"name": "Neutral 400"
				},
				{
					"slug": "neutral-500",
					"color": "#737373",
					"name": "Neutral 500"
				},
				{
					"slug": "neutral-600",
					"color": "#525252",
					"name": "Neutral 600"
				},
				{
					"slug": "neutral-700",
					"color": "#404040",
					"name": "Neutral 700"
				},
				{
					"slug": "neutral-800",
					"color": "#262626",
					"name": "Neutral 800"
				},
				{
					"slug": "neutral-900",
					"color": "#171717",
					"name": "Neutral 900"
				},
				{
					"slug": "success",
					"color": "#00a32a",
					"name": "Success"
				},
				{
					"slug": "warning",
					"color": "#f0b849",
					"name": "Warning"
				},
				{
					"slug": "error",
					"color": "#d63638",
					"name": "Error"
				}
			],
			"gradients": [
				{
					"slug": "primary-accent",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--accent) 100%)",
					"name": "Primary to Accent"
				},
				{
					"slug": "neutral-fade",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--neutral-100) 0%, var(--wp--preset--color--neutral-300) 100%)",
					"name": "Neutral Fade"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true,
			"writingMode": false,
			"dropCap": false,
			"fontSizes": [
				{
					"slug": "2xs",
					"size": "0.512rem",
					"name": "2XS"
				},
				{
					"slug": "xs",
					"size": "0.64rem",
					"name": "XS"
				},
				{
					"slug": "small",
					"size": "0.8rem",
					"name": "Small"
				},
				{
					"slug": "base",
					"size": "1rem",
					"name": "Base"
				},
				{
					"slug": "medium",
					"size": "1.25rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.563rem",
					"name": "Large"
				},
				{
					"slug": "xl",
					"size": "1.953rem",
					"name": "XL"
				},
				{
					"slug": "2xl",
					"size": "2.441rem",
					"name": "2XL"
				},
				{
					"slug": "3xl",
					"size": "3.052rem",
					"name": "3XL"
				}
			],
			"fontFamilies": [
				{
					"slug": "system",
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
					"name": "System Font"
				},
				{
					"slug": "body",
					"fontFamily": "sans-serif",
					"name": "Body Font"
				},
				{
					"slug": "heading",
					"fontFamily": "serif",
					"name": "Heading Font"
				}
			]
		},
		"spacing": {
			"customSpacing": true,
			"spacingScale": {
				"operator": "*",
				"increment": 1.25,
				"steps": 7,
				"mediumStep": 1.5,
				"unit": "rem"
			},
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingSizes": [
				{
					"slug": "2xs",
					"size": "0.512rem",
					"name": "2XS"
				},
				{
					"slug": "xs",
					"size": "0.64rem",
					"name": "XS"
				},
				{
					"slug": "small",
					"size": "0.8rem",
					"name": "Small"
				},
				{
					"slug": "base",
					"size": "1rem",
					"name": "Base"
				},
				{
					"slug": "medium",
					"size": "1.25rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.563rem",
					"name": "Large"
				},
				{
					"slug": "xl",
					"size": "1.953rem",
					"name": "XL"
				},
				{
					"slug": "2xl",
					"size": "2.441rem",
					"name": "2XL"
				},
				{
					"slug": "3xl",
					"size": "3.052rem",
					"name": "3XL"
				}
			]
		},
		"layout": {
			"contentSize": "1280px",
			"wideSize": "1400px",
			"allowEditing": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"dimensions": {
			"minHeight": true
		},
		"position": {
			"sticky": true
		},
		"shadow": {
			"presets": [
				{
					"slug": "natural",
					"shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06)",
					"name": "Natural"
				},
				{
					"slug": "deep",
					"shadow": "0 10px 25px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
					"name": "Deep"
				}
			]
		},
		"blocks": {
			"core/button": {
				"color": {
					"custom": true,
					"customGradient": true
				},
				"typography": {
					"fontSizes": [
						{
							"slug": "small",
							"size": "0.8rem",
							"name": "Small"
						},
						{
							"slug": "medium",
							"size": "1rem",
							"name": "Medium"
						},
						{
							"slug": "large",
							"size": "1.25rem",
							"name": "Large"
						}
					]
				},
				"spacing": {
					"padding": true
				},
				"border": {
					"radius": true
				}
			},
			"core/heading": {
				"color": {
					"custom": true
				},
				"typography": {
					"fontSizes": [
						{
							"slug": "h1",
							"size": "3.052rem",
							"name": "H1"
						},
						{
							"slug": "h2",
							"size": "2.441rem",
							"name": "H2"
						},
						{
							"slug": "h3",
							"size": "1.953rem",
							"name": "H3"
						},
						{
							"slug": "h4",
							"size": "1.563rem",
							"name": "H4"
						},
						{
							"slug": "h5",
							"size": "1.25rem",
							"name": "H5"
						},
						{
							"slug": "h6",
							"size": "1rem",
							"name": "H6"
						}
					]
				}
			},
			"core/paragraph": {
				"color": {
					"custom": true
				},
				"typography": {
					"dropCap": true
				}
			},
			"core/list": {
				"spacing": {
					"padding": true
				}
			},
			"core/quote": {
				"spacing": {
					"padding": true
				},
				"typography": {
					"fontStyle": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--black)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--base)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--base)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					},
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					},
					"outline": {
						"width": "2px",
						"style": "solid",
						"color": "var(--wp--preset--color--accent)",
						"offset": "2px"
					}
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--3xl)",
					"lineHeight": "1.2",
					"fontWeight": "700"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--large)"
					}
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--2xl)",
					"lineHeight": "1.2",
					"fontWeight": "700"
				},
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--xl)",
						"bottom": "var(--wp--preset--spacing--medium)"
					}
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--xl)",
					"lineHeight": "1.3",
					"fontWeight": "600"
				},
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--large)",
						"bottom": "var(--wp--preset--spacing--medium)"
					}
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.3",
					"fontWeight": "600"
				},
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--large)",
						"bottom": "var(--wp--preset--spacing--small)"
					}
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.4",
					"fontWeight": "600"
				},
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--medium)",
						"bottom": "var(--wp--preset--spacing--small)"
					}
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--base)",
					"lineHeight": "1.4",
					"fontWeight": "600",
					"textTransform": "uppercase",
					"letterSpacing": "0.05em"
				},
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--medium)",
						"bottom": "var(--wp--preset--spacing--small)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--base)",
					"fontWeight": "500",
					"lineHeight": "1.2"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--small)",
						"right": "var(--wp--preset--spacing--medium)",
						"bottom": "var(--wp--preset--spacing--small)",
						"left": "var(--wp--preset--spacing--medium)"
					}
				},
				"border": {
					"radius": "0.375rem"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)"
					}
				},
				":focus": {
					"outline": {
						"width": "2px",
						"style": "solid",
						"color": "var(--wp--preset--color--accent)",
						"offset": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": {
							"background": "transparent",
							"text": "var(--wp--preset--color--accent)"
						},
						"border": {
							"color": "var(--wp--preset--color--accent)",
							"style": "solid",
							"width": "2px"
						},
						":hover": {
							"color": {
								"background": "var(--wp--preset--color--accent)",
								"text": "var(--wp--preset--color--white)"
							}
						}
					}
				}
			},
			"core/quote": {
				"color": {
					"text": "var(--wp--preset--color--neutral-700)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontStyle": "italic",
					"lineHeight": "1.6"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--medium)",
						"right": "var(--wp--preset--spacing--large)",
						"bottom": "var(--wp--preset--spacing--medium)",
						"left": "var(--wp--preset--spacing--large)"
					}
				},
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "4px"
					}
				}
			},
			"core/pullquote": {
				"color": {
					"text": "var(--wp--preset--color--neutral-700)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xl)",
					"fontStyle": "italic",
					"lineHeight": "1.4",
					"textAlign": "center"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--xl)",
						"right": "var(--wp--preset--spacing--medium)",
						"bottom": "var(--wp--preset--spacing--xl)",
						"left": "var(--wp--preset--spacing--medium)"
					}
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--neutral-100)",
					"text": "var(--wp--preset--color--neutral-800)"
				},
				"typography": {
					"fontFamily": "SFMono-Regular, Consolas, 'Liberation Mono', Menlo, monospace",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--xs)",
						"right": "var(--wp--preset--spacing--small)",
						"bottom": "var(--wp--preset--spacing--xs)",
						"left": "var(--wp--preset--spacing--small)"
					}
				},
				"border": {
					"radius": "0.25rem"
				}
			},
			"core/preformatted": {
				"color": {
					"background": "var(--wp--preset--color--neutral-800)",
					"text": "var(--wp--preset--color--neutral-100)"
				},
				"typography": {
					"fontFamily": "SFMono-Regular, Consolas, 'Liberation Mono', Menlo, monospace",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--medium)",
						"right": "var(--wp--preset--spacing--medium)",
						"bottom": "var(--wp--preset--spacing--medium)",
						"left": "var(--wp--preset--spacing--medium)"
					}
				},
				"border": {
					"radius": "0.5rem"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "sidebar",
			"title": "Sidebar",
			"area": "uncategorized"
		}
	],
	"customTemplates": [
		{
			"name": "page-landing",
			"title": "Landing Page"
		},
		{
			"name": "single-portfolio",
			"title": "Portfolio Single"
		}
	]
}
