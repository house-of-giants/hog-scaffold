<?xml version="1.0"?>
<ruleset name="WordPress Theme Coding Standards">
	<description>Sniffs for WordPress themes</description>

	<!-- What to scan -->
	<file>.</file>

	<!-- Exclude vendor and build directories -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/.git/*</exclude-pattern>
	<exclude-pattern>/.taskmaster/*</exclude-pattern>
	<exclude-pattern>/.cursor/*</exclude-pattern>
	
	<!-- Exclude JavaScript files - should be handled by ESLint -->
	<exclude-pattern>*.js</exclude-pattern>
	<exclude-pattern>*.json</exclude-pattern>

	<!-- Rules: Use WordPress Coding Standards -->
	<rule ref="WordPress">
		<!-- Allow short array syntax -->
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		
		<!-- Allow camelCase function names for compatibility -->
		<exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
		
		<!-- Relax hook name validation -->
		<exclude name="WordPress.NamingConventions.ValidHookName.UseUnderscores"/>
		
		<!-- Relax some documentation requirements for development -->
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
		<exclude name="Squiz.Commenting.FileComment.MissingPackageTag"/>
		<exclude name="Squiz.Commenting.FileComment.SpacingAfterComment"/>
		<exclude name="Squiz.Commenting.FileComment.WrongStyle"/>
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
		<exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
		<exclude name="Squiz.Commenting.FunctionComment.Missing"/>
		
		<!-- Allow reserved keywords as parameter names in certain contexts -->
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames.functionFound"/>
		
		<!-- Allow some commented out code for development -->
		<exclude name="Squiz.PHP.CommentedOutCode.Found"/>
	</rule>

	<!-- Set minimum WordPress version -->
	<config name="minimum_supported_wp_version" value="6.0"/>

	<!-- Show warnings and errors with sniff codes -->
	<arg value="s"/>
	<arg name="report-width" value="auto"/>
	<arg name="cache"/>
	
	<!-- Use colors in output -->
	<arg name="colors"/>
	
	<!-- Show progress -->
	<arg value="p"/>
</ruleset>