# Docker Development Environment Configuration
# Copy this to .env for local development

# WordPress Configuration
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_ROOT_PASSWORD=rootpassword

# WordPress Debug Settings
WORDPRESS_DEBUG=1
WORDPRESS_DEBUG_LOG=1
WORDPRESS_DEBUG_DISPLAY=0
WP_ENVIRONMENT_TYPE=local

# Redis Configuration
WP_REDIS_HOST=redis
WP_REDIS_PORT=6379
WP_REDIS_DATABASE=0

# WordPress URLs (update with your local domain)
WORDPRESS_HOME=http://localhost:8080
WORDPRESS_SITEURL=http://localhost:8080/wp

# Development Settings
SCRIPT_DEBUG=1
CONCATENATE_SCRIPTS=0
COMPRESS_SCRIPTS=0
COMPRESS_CSS=0

# Mail Configuration (MailHog)
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=

# Node.js Development
NODE_ENV=development

# Xdebug Configuration
XDEBUG_MODE=debug,develop
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
XDEBUG_IDE_KEY=VSCODE

# Database Configuration
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci

# Container Names (for reference)
WORDPRESS_CONTAINER=hog-scaffold-wp
DB_CONTAINER=hog-scaffold-db
REDIS_CONTAINER=hog-scaffold-redis
PHPMYADMIN_CONTAINER=hog-scaffold-pma
MAILHOG_CONTAINER=hog-scaffold-mail
WPCLI_CONTAINER=hog-scaffold-wpcli
NODE_CONTAINER=hog-scaffold-node

# Port Mappings
WORDPRESS_PORT=8080
WORDPRESS_SSL_PORT=8443
DB_PORT=3306
REDIS_PORT=6379
PHPMYADMIN_PORT=8081
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
NODE_DEV_PORT=3000 