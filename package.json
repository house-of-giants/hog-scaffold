{
	"name": "hog-scaffold",
	"version": "1.2.0",
	"type": "module",
	"author": "House of Giants",
	"repository": {
		"url": "https://github.com/house-of-giants/hog-scaffold"
	},
	"scripts": {
		"start": "npm install && npm run build",
		"dev": "NODE_ENV=development webpack --config config/webpack.dev.cjs",
		"dev:watch": "NODE_ENV=development webpack --watch --config config/webpack.dev.cjs",
		"dev:serve": "NODE_ENV=development webpack serve --config config/webpack.dev.cjs",
		"dev:blocks": "wp-scripts start",
		"build": "run-p build:blocks-manifest build:theme",
		"build:sequential": "run-s build:blocks-manifest build:theme",
		"build:theme": "NODE_ENV=production webpack --config config/webpack.prod.cjs",
		"build:blocks": "wp-scripts build",
		"build:blocks-manifest": "wp-scripts build --blocks-manifest --webpack-src-dir=src/blocks --output-path=inc/blocks",
		"build:production": "npm install && composer install --no-dev -o && npm run build",
		"build:analyze": "NODE_ENV=production webpack --config config/webpack.prod.cjs --analyze",
		"build:stats": "NODE_ENV=production webpack --config config/webpack.prod.cjs --json > webpack-stats.json",
		"watch": "run-p watch:*",
		"watch:theme": "npm run dev:watch",
		"watch:blocks": "wp-scripts start",
		"lint": "run-p lint:*",
		"lint:css": "stylelint assets/css",
		"lint:js": "eslint assets/js",
		"lint:php": "composer run lint",
		"format": "run-p format:*",
		"format:js": "eslint --fix assets/js",
		"format:css": "stylelint --fix assets/css",
		"clean": "run-p clean:*",
		"clean:dist": "rm -rf dist/",
		"clean:cache": "rm -rf node_modules/.cache/",
		"clean:all": "rm -rf dist/ node_modules/ vendor/ && npm install && composer install",
		"test": "run-s lint build",
		"bundle-analyzer": "webpack-bundle-analyzer dist/webpack-stats.json",
		"wp:start": "wp-scripts start",
		"wp:build": "wp-scripts build",
		"wp:check-engines": "wp-scripts check-engines",
		"wp:check-licenses": "wp-scripts check-licenses",
		"wp:format": "wp-scripts format",
		"wp:lint-css": "wp-scripts lint-style",
		"wp:lint-js": "wp-scripts lint-js",
		"wp:lint-md-docs": "wp-scripts lint-md-docs",
		"wp:lint-md-js": "wp-scripts lint-md-js",
		"wp:lint-pkg-json": "wp-scripts lint-pkg-json",
		"wp:packages-update": "wp-scripts packages-update",
		"wp:plugin-zip": "wp-scripts plugin-zip",
		"wp:test-e2e": "wp-scripts test-e2e",
		"wp:test-unit-js": "wp-scripts test-unit-js",
		"cache:clear": "wp eval-file scripts/cache-management.php clear",
		"cache:clear-object": "wp eval-file scripts/cache-management.php clear object",
		"cache:clear-page": "wp eval-file scripts/cache-management.php clear page",
		"cache:clear-transients": "wp eval-file scripts/cache-management.php clear transients",
		"cache:status": "wp eval-file scripts/cache-management.php status"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.css": [
			"stylelint --fix"
		],
		"*.js": [
			"eslint --fix"
		],
		"*.php": [
			"./vendor/bin/phpcs --extensions=php --warning-severity=8 -s"
		]
	},
	"license": "ISC",
	"devDependencies": {
		"@babel/core": "^7.27.4",
		"@babel/eslint-parser": "^7.27.1",
		"@babel/preset-env": "^7.27.2",
		"@babel/preset-react": "^7.27.1",
		"@wordpress/babel-preset-default": "^7.42.0",
		"@wordpress/dependency-extraction-webpack-plugin": "^4.31.0",
		"@wordpress/icons": "^10.24.0",
		"@wordpress/scripts": "^30.7.0",
		"babel-loader": "^10.0.0",
		"browser-sync": "^3.0.4",
		"clean-webpack-plugin": "^4.0.0",
		"copy-webpack-plugin": "^13.0.0",
		"core-js": "^3.42.0",
		"critical": "^7.2.1",
		"cross-env": "^7.0.3",
		"css-loader": "^7.1.2",
		"css-minimizer-webpack-plugin": "^7.0.2",
		"cssnano": "^7.0.7",
		"eslint": "^9.28.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.4.1",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-webpack-plugin": "^5.0.1",
		"file-loader": "^6.2.0",
		"html-webpack-plugin": "^5.6.3",
		"image-minimizer-webpack-plugin": "^4.1.3",
		"imagemin": "^8.0.1",
		"imagemin-svgo": "^11.0.1",
		"imagemin-webp": "^8.0.0",
		"loadcss": "^0.0.2",
		"mini-css-extract-plugin": "^2.9.2",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.4",
		"postcss-import": "^16.1.0",
		"postcss-loader": "^8.1.1",
		"postcss-mixins": "^11.0.3",
		"postcss-nesting": "^13.0.1",
		"postcss-preset-env": "^10.2.0",
		"preload-webpack-plugin": "^3.0.0-beta.4",
		"prettier": "^3.5.3",
		"sharp": "^0.33.5",
		"style-loader": "^4.0.0",
		"stylelint": "^16.20.0",
		"stylelint-config-recommended": "^16.0.0",
		"stylelint-order": "^7.0.0",
		"stylelint-webpack-plugin": "^5.0.1",
		"webpack": "^5.99.9",
		"webpack-bundle-analyzer": "^4.10.2",
		"webpack-cli": "^6.0.1",
		"webpackbar": "^7.0.0"
	},
	"dependencies": {
		"normalize.css": "^8.0.1",
		"prop-types": "^15.8.1"
	}
}
