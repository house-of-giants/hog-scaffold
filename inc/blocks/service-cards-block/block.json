{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hog-scaffold/service-cards",
	"title": "Service Cards",
	"category": "hog-scaffold-blocks",
	"icon": "grid-view",
	"description": "Display service or feature cards with icons, titles, descriptions, and links in a responsive grid layout",
	"keywords": ["services", "cards", "features", "grid", "icons"],
	"textdomain": "hog-scaffold",
	"editorScript": "file:./editor.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"supports": {
		"align": true,
		"alignWide": true,
		"anchor": true,
		"ariaLabel": true,
		"color": {
			"gradients": true,
			"background": true,
			"text": true,
			"link": true
		},
		"customClassName": true,
		"dimensions": {
			"minHeight": true
		},
		"html": false,
		"inserter": true,
		"lock": false,
		"multiple": true,
		"position": {
			"sticky": true
		},
		"reusable": true,
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		}
	},
	"attributes": {
		"cards": {
			"type": "array",
			"default": [
				{
					"id": 1,
					"title": "Service One",
					"description": "Description of your first service or feature",
					"icon": "",
					"link": {
						"url": "#",
						"opensInNewTab": false
					}
				},
				{
					"id": 2,
					"title": "Service Two",
					"description": "Description of your second service or feature",
					"icon": "",
					"link": {
						"url": "#",
						"opensInNewTab": false
					}
				},
				{
					"id": 3,
					"title": "Service Three",
					"description": "Description of your third service or feature",
					"icon": "",
					"link": {
						"url": "#",
						"opensInNewTab": false
					}
				}
			]
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"layout": {
			"type": "string",
			"default": "grid",
			"enum": ["grid", "list", "carousel"]
		},
		"showIcons": {
			"type": "boolean",
			"default": true
		},
		"cardStyle": {
			"type": "string",
			"default": "default",
			"enum": ["default", "bordered", "shadow", "minimal"]
		}
	},
	"example": {
		"attributes": {
			"cards": [
				{
					"id": 1,
					"title": "Web Design",
					"description": "Beautiful, responsive websites that convert visitors into customers",
					"icon": "🎨",
					"link": {
						"url": "#",
						"opensInNewTab": false
					}
				},
				{
					"id": 2,
					"title": "Development",
					"description": "Custom web applications built with modern technologies",
					"icon": "💻",
					"link": {
						"url": "#",
						"opensInNewTab": false
					}
				}
			],
			"columns": 2,
			"layout": "grid"
		}
	},
	"variations": [
		{
			"name": "service-cards-minimal",
			"title": "Minimal Service Cards",
			"description": "Clean, minimal service cards without borders",
			"attributes": {
				"cardStyle": "minimal",
				"showIcons": false,
				"layout": "grid"
			},
			"isDefault": false
		},
		{
			"name": "service-cards-shadow",
			"title": "Shadow Service Cards",
			"description": "Service cards with shadow effect",
			"attributes": {
				"cardStyle": "shadow",
				"layout": "grid",
				"columns": 3
			},
			"isDefault": false
		},
		{
			"name": "service-cards-list",
			"title": "Service List",
			"description": "Services displayed in a list format",
			"attributes": {
				"layout": "list",
				"cardStyle": "bordered"
			},
			"isDefault": false
		}
	]
}
