{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hog-scaffold/container",
	"title": "Container",
	"category": "hog-scaffold-blocks",
	"icon": "editor-table",
	"description": "A flexible container block with width controls, spacing options, and background settings.",
	"keywords": ["container", "layout", "section", "wrapper"],
	"textdomain": "hog-scaffold",
	"editorScript": "file:../../../js/layout-container-editor.js",
	"editorStyle": "file:../../../css/layout-container-editor-style.css",
	"style": "file:../../../css/layout-container-style.css",
	"supports": {
		"align": ["wide", "full"],
		"alignWide": true,
		"anchor": true,
		"ariaLabel": true,
		"color": {
			"gradients": true,
			"background": true,
			"text": true,
			"link": true
		},
		"customClassName": true,
		"dimensions": {
			"minHeight": true
		},
		"html": false,
		"inserter": true,
		"lock": false,
		"multiple": true,
		"position": {
			"sticky": false
		},
		"reusable": true,
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": false
		},
		"typography": {
			"fontSize": false,
			"lineHeight": false
		}
	},
	"attributes": {
		"width": {
			"type": "string",
			"default": "standard",
			"enum": ["narrow", "standard", "wide", "full"]
		},
		"spacing": {
			"type": "object",
			"default": {
				"marginTop": "medium",
				"marginBottom": "medium",
				"marginLeft": "none",
				"marginRight": "none",
				"paddingTop": "medium",
				"paddingBottom": "medium",
				"paddingLeft": "medium",
				"paddingRight": "medium",
				"customMarginTop": 0,
				"customMarginBottom": 0,
				"customMarginLeft": 0,
				"customMarginRight": 0,
				"customPaddingTop": 0,
				"customPaddingBottom": 0,
				"customPaddingLeft": 0,
				"customPaddingRight": 0,
				"linkSpacing": false
			}
		},
		"background": {
			"type": "object",
			"default": {
				"backgroundColor": "",
				"backgroundImage": null,
				"backgroundSize": "cover",
				"backgroundPosition": "center",
				"backgroundRepeat": "no-repeat",
				"backgroundAttachment": "scroll",
				"overlay": false,
				"overlayColor": "",
				"overlayOpacity": 50
			}
		},
		"contentAlignment": {
			"type": "string",
			"default": "left",
			"enum": ["left", "center", "right"]
		},
		"minHeight": {
			"type": "string",
			"default": ""
		}
	},
	"providesContext": {
		"hog-scaffold/containerWidth": "width",
		"hog-scaffold/containerAlignment": "contentAlignment"
	},
	"example": {
		"attributes": {
			"width": "standard",
			"contentAlignment": "center",
			"spacing": {
				"paddingTop": "large",
				"paddingBottom": "large",
				"paddingLeft": "medium",
				"paddingRight": "medium"
			}
		},
		"innerBlocks": [
			{
				"name": "core/heading",
				"attributes": {
					"content": "Container Block Example",
					"level": 2
				}
			},
			{
				"name": "core/paragraph",
				"attributes": {
					"content": "This container block provides flexible width controls, spacing options, and background settings for organizing your content."
				}
			}
		]
	},
	"variations": [
		{
			"name": "container-narrow",
			"title": "Narrow Container",
			"description": "A narrow container for focused content",
			"attributes": {
				"width": "narrow",
				"contentAlignment": "center"
			},
			"scope": ["inserter"]
		},
		{
			"name": "container-hero",
			"title": "Hero Container",
			"description": "A full-width container with large padding for hero sections",
			"attributes": {
				"width": "full",
				"spacing": {
					"paddingTop": "xl",
					"paddingBottom": "xl",
					"paddingLeft": "large",
					"paddingRight": "large"
				},
				"contentAlignment": "center"
			},
			"scope": ["inserter"]
		}
	]
}
