{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hog-scaffold/cta",
	"title": "Call to Action",
	"category": "hog-scaffold-blocks",
	"icon": "megaphone",
	"description": "A compelling call-to-action section with heading, text, button, and background options.",
	"keywords": ["cta", "call-to-action", "button", "conversion", "action"],
	"textdomain": "hog-scaffold",
	"editorScript": "file:./editor.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"supports": {
		"html": false,
		"anchor": true,
		"ariaLabel": true,
		"align": ["wide", "full"],
		"color": {
			"gradients": true,
			"background": true,
			"text": true,
			"link": true
		},
		"customClassName": true,
		"dimensions": {
			"minHeight": true
		},
		"lock": false,
		"multiple": true,
		"position": {
			"sticky": true
		},
		"reusable": true,
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		}
	},
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Ready to Get Started?"
		},
		"text": {
			"type": "string",
			"default": "Join thousands of satisfied customers and take the next step towards achieving your goals."
		},
		"buttonText": {
			"type": "string",
			"default": "Get Started Now"
		},
		"buttonUrl": {
			"type": "string",
			"default": ""
		},
		"buttonStyle": {
			"type": "string",
			"default": "primary",
			"enum": ["primary", "secondary", "outline", "link"]
		},
		"buttonSize": {
			"type": "string",
			"default": "medium",
			"enum": ["small", "medium", "large"]
		},
		"buttonOpenInNewTab": {
			"type": "boolean",
			"default": false
		},
		"layout": {
			"type": "string",
			"default": "centered",
			"enum": ["centered", "left", "right", "split"]
		},
		"backgroundType": {
			"type": "string",
			"default": "color",
			"enum": ["none", "color", "gradient", "image"]
		},
		"backgroundColor": {
			"type": "string",
			"default": ""
		},
		"backgroundGradient": {
			"type": "string",
			"default": ""
		},
		"backgroundImage": {
			"type": "object",
			"default": {
				"url": "",
				"alt": "",
				"id": 0
			}
		},
		"backgroundPosition": {
			"type": "string",
			"default": "center center"
		},
		"backgroundSize": {
			"type": "string",
			"default": "cover"
		},
		"backgroundOverlay": {
			"type": "boolean",
			"default": false
		},
		"backgroundOverlayColor": {
			"type": "string",
			"default": "rgba(0, 0, 0, 0.5)"
		},
		"width": {
			"type": "string",
			"default": "normal",
			"enum": ["normal", "wide", "full"]
		},
		"spacing": {
			"type": "string",
			"default": "medium",
			"enum": ["small", "medium", "large", "extra-large"]
		}
	},
	"example": {
		"attributes": {
			"heading": "Transform Your Business Today",
			"text": "Join thousands of satisfied customers who have already transformed their business with our solutions.",
			"buttonText": "Start Your Journey",
			"layout": "centered"
		}
	},
	"variations": [
		{
			"name": "cta-minimal",
			"title": "Minimal CTA",
			"description": "A clean, minimal call-to-action",
			"attributes": {
				"layout": "centered",
				"backgroundType": "none",
				"buttonStyle": "outline"
			},
			"isDefault": false
		},
		{
			"name": "cta-gradient",
			"title": "Gradient CTA",
			"description": "Call-to-action with gradient background",
			"attributes": {
				"layout": "centered",
				"backgroundType": "gradient",
				"buttonStyle": "primary"
			},
			"isDefault": false
		},
		{
			"name": "cta-split",
			"title": "Split Layout CTA",
			"description": "Call-to-action with split layout design",
			"attributes": {
				"layout": "split",
				"backgroundType": "color"
			},
			"isDefault": false
		}
	]
}
