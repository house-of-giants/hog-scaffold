{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hog-scaffold/hero-section",
	"title": "Hero Section",
	"category": "hog-scaffold-blocks",
	"icon": "cover-image",
	"description": "A hero section with multiple layout options, background support, and call-to-action buttons",
	"keywords": ["hero", "banner", "header", "cta", "background"],
	"textdomain": "hog-scaffold",
	"editorScript": "file:./editor.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Welcome to our website"
		},
		"subheading": {
			"type": "string",
			"default": "Create something amazing with us"
		},
		"layout": {
			"type": "string",
			"default": "centered",
			"enum": ["centered", "left-aligned", "split", "minimal"]
		},
		"backgroundImage": {
			"type": "object",
			"default": {}
		},
		"backgroundVideo": {
			"type": "string",
			"default": ""
		},
		"showOverlay": {
			"type": "boolean",
			"default": true
		},
		"overlayOpacity": {
			"type": "number",
			"default": 0.4
		},
		"primaryButton": {
			"type": "object",
			"default": {
				"text": "Get Started",
				"url": "#",
				"opensInNewTab": false
			}
		},
		"secondaryButton": {
			"type": "object",
			"default": {
				"text": "",
				"url": "#",
				"opensInNewTab": false
			}
		},
		"minHeight": {
			"type": "string",
			"default": "60vh"
		}
	},
	"example": {
		"attributes": {
			"heading": "Hero Section Example",
			"subheading": "This is how your hero section will look",
			"layout": "centered"
		}
	},
	"supports": {
		"align": true,
		"alignWide": true,
		"anchor": true,
		"ariaLabel": true,
		"color": {
			"gradients": true,
			"background": true,
			"text": true,
			"link": true
		},
		"customClassName": true,
		"dimensions": {
			"minHeight": true
		},
		"html": false,
		"inserter": true,
		"lock": false,
		"multiple": true,
		"position": {
			"sticky": true
		},
		"reusable": true,
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		}
	},
	"variations": [
		{
			"name": "hero-minimal",
			"title": "Minimal Hero",
			"description": "A clean, minimal hero section",
			"attributes": {
				"layout": "minimal"
			},
			"isDefault": false
		},
		{
			"name": "hero-split",
			"title": "Split Hero",
			"description": "Hero section with split layout",
			"attributes": {
				"layout": "split"
			},
			"isDefault": false
		}
	]
}
